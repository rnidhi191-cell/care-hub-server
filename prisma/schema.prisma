datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. ORGANIZATION & STRUCTURE
// -------------------------------------------------------------

model Organization {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  description String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  departments Department[]
  locations   Location[]
  employees   Employee[]
  reviewCycles ReviewCycle[]

  @@map("organizations")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teams          Team[]
  employees      Employee[]

  @@unique([organizationId, code])
  @@map("departments")
}

model Team {
  id           String     @id @default(uuid())
  departmentId String
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@map("teams")
}

model JobTitle {
  id          String     @id @default(uuid())
  title       String     @unique
  level       String?
  description String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  employees   Employee[]

  @@map("job_titles")
}

model Location {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  country        String
  city           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]

  @@map("locations")
}

// -------------------------------------------------------------
// 2. USERS, ROLES, PERMISSIONS & AUTH
// -------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  passwordHash       String
  name               String
  status             UserStatus     @default(ACTIVE)
  passwordResetToken String?
  passwordResetExpiry DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  userRoles          UserRole[]
  refreshTokens      RefreshToken[]
  employee           Employee?
  notifications      Notification[]
  auditLogs          AuditLog[]
  uploadedFiles      FileAttachment[]

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  deviceInfo  String?
  ipAddress   String?
  revoked     Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?          @db.Text
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique // e.g. "review:create"
  category    String           // e.g. "review", "employee", "goal"
  description String?          @db.Text
  createdAt   DateTime         @default(now())

  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// -------------------------------------------------------------
// 3. EMPLOYEES & REPORTING LINES
// -------------------------------------------------------------

enum EmploymentStatus {
  FULL_TIME
  PART_TIME
  PROBATION
  CONTRACT
  TERMINATED
}

model Employee {
  id               String           @id @default(uuid())
  userId           String           @unique
  organizationId   String
  departmentId     String?
  teamId           String?
  jobTitleId       String?
  locationId       String?
  employeeCode     String           @unique
  phoneNumber      String?
  joiningDate      DateTime
  employmentStatus EmploymentStatus @default(FULL_TIME)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department       Department?      @relation(fields: [departmentId], references: [id])
  team             Team?            @relation(fields: [teamId], references: [id])
  jobTitle         JobTitle?        @relation(fields: [jobTitleId], references: [id])
  location         Location?        @relation(fields: [locationId], references: [id])

  managers         EmployeeManager[] @relation("DirectReport")
  subordinates     EmployeeManager[] @relation("Manager")
  reviews          EmployeeReview[]
  developmentPlans DevelopmentPlan[]

  @@map("employees")
}

model EmployeeManager {
  id          String   @id @default(uuid())
  employeeId  String
  managerId   String
  isPrimary   Boolean  @default(true)
  createdAt   DateTime @default(now())

  employee    Employee @relation("DirectReport", fields: [employeeId], references: [id], onDelete: Cascade)
  manager     Employee @relation("Manager", fields: [managerId], references: [id], onDelete: Cascade)

  @@unique([employeeId, managerId])
  @@map("employee_managers")
}

// -------------------------------------------------------------
// 4. REVIEW CYCLES & WORKFLOW
// -------------------------------------------------------------

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

model ReviewCycle {
  id             String            @id @default(uuid())
  organizationId String
  title          String            // e.g. "April 2026 Annual Review"
  cycleName      String            // "April" | "September"
  year           Int
  startDate      DateTime
  endDate        DateTime
  selfReviewDue  DateTime
  managerReviewDue DateTime
  hrValidationDue DateTime
  status         ReviewCycleStatus @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages         ReviewCycleStage[]
  reviews        EmployeeReview[]
  developmentPlans DevelopmentPlan[]

  @@unique([organizationId, cycleName, year])
  @@map("review_cycles")
}

model ReviewCycleStage {
  id            String      @id @default(uuid())
  reviewCycleId String
  stageOrder    Int
  name          String      // e.g. "SELF_REVIEW", "REVIEWER_ASSESSMENT", "HR_VALIDATION"
  startDate     DateTime
  dueDate       DateTime
  isCompleted   Boolean     @default(false)

  reviewCycle   ReviewCycle @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)

  @@map("review_cycle_stages")
}

enum ReviewWorkflowState {
  DRAFT
  SELF_REVIEW
  REVIEWER_ASSESSMENT
  HR_VALIDATION
  CALIBRATION
  PERFORMANCE_DISCUSSION
  FINALIZED
  ACKNOWLEDGEMENT
  COMPLETED
  PROGRESS_CHECK
  RETURNED
  OVERDUE
  REOPENED
  CANCELLED
}

model EmployeeReview {
  id                   String              @id @default(uuid())
  reviewCycleId        String
  employeeId           String
  workflowState        ReviewWorkflowState @default(SELF_REVIEW)
  hrAssisted           Boolean             @default(false)
  hrAssistanceReason   String?             @db.Text
  hrAssistedBy         String?
  overdueDate          DateTime?
  submittedAt          DateTime?
  finalizedAt          DateTime?
  acknowledgedAt       DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  reviewCycle          ReviewCycle         @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  employee             Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  selfReview           SelfReview?
  reviewerAssessment   ReviewerAssessment?
  hrValidation         HRValidation?
  calibration          Calibration?
  performanceDiscussion PerformanceDiscussion?
  finalRating          FinalRating?
  acknowledgement      Acknowledgement?
  progressChecks       ProgressCheck[]
  reviewGoals          ReviewGoal[]

  @@unique([reviewCycleId, employeeId])
  @@map("employee_reviews")
}

// -------------------------------------------------------------
// 5. CARE SELF REVIEW & GOALS
// -------------------------------------------------------------

model SelfReview {
  id               String         @id @default(uuid())
  employeeReviewId String         @unique
  contribute       String?        @db.Text // C - Contribute
  achieve          String?        @db.Text // A - Achieve
  reflect          String?        @db.Text // R - Reflect
  evolve           String?        @db.Text // E - Evolve
  isDraft          Boolean        @default(true)
  submittedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  employeeReview   EmployeeReview @relation(fields: [employeeReviewId], references: [id], onDelete: Cascade)

  @@map("self_reviews")
}

enum GoalCategory {
  BUSINESS
  CUSTOMER
  FINANCIAL
  OPERATIONAL
  PEOPLE
  LEARNING_DEVELOPMENT
  INNOVATION
  FUNCTIONAL
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  EXCEEDED
  PARTIALLY_ACHIEVED
  DEFERRED
}

model ReviewGoal {
  id               String          @id @default(uuid())
  employeeReviewId String
  title            String
  description      String?         @db.Text
  category         GoalCategory    @default(BUSINESS)
  weight           Float           @default(1.0)
  targetMetric     String?
  measurement      String?
  startDate        DateTime?
  dueDate          DateTime?
  status           GoalStatus      @default(NOT_STARTED)
  employeeComment  String?         @db.Text
  achievementPct   Float           @default(0.0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  employeeReview   EmployeeReview  @relation(fields: [employeeReviewId], references: [id], onDelete: Cascade)
  assessment       GoalAssessment?

  @@map("review_goals")
}

model GoalAssessment {
  id           String     @id @default(uuid())
  reviewGoalId String     @unique
  reviewerId   String
  rating       Float      // 1 to 5
  comments     String?    @db.Text
  evidence     String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  reviewGoal   ReviewGoal @relation(fields: [reviewGoalId], references: [id], onDelete: Cascade)

  @@map("goal_assessments")
}

// -------------------------------------------------------------
// 6. MANAGER ASSESSMENT & COMPETENCY RATINGS
// -------------------------------------------------------------

model ReviewerAssessment {
  id                   String              @id @default(uuid())
  employeeReviewId     String              @unique
  reviewerId           String
  recommendedRating    Float?              // 1 to 5
  overallSummary       String?             @db.Text
  strengths            String?             @db.Text
  areasForImprovement  String?             @db.Text
  isSubmitted          Boolean             @default(false)
  submittedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  employeeReview       EmployeeReview      @relation(fields: [employeeReviewId], references: [id], onDelete: Cascade)
  competencyRatings    CompetencyRating[]

  @@map("reviewer_assessments")
}

model CompetencyRating {
  id                   String             @id @default(uuid())
  reviewerAssessmentId String
  competencyName       String             // "Quality of Work", "Productivity", "Communication", etc.
  rating               Int                // 1 to 5
  comments             String?            @db.Text
  createdAt            DateTime           @default(now())

  reviewerAssessment   ReviewerAssessment @relation(fields: [reviewerAssessmentId], references: [id], onDelete: Cascade)

  @@map("competency_ratings")
}

// -------------------------------------------------------------
// 7. HR VALIDATION, CALIBRATION & FINALIZATION
// -------------------------------------------------------------

enum HRValidationStatus {
  PENDING
  APPROVED
  RETURNED
  CORRECTION_REQUESTED
}

model HRValidation {
  id               String             @id @default(uuid())
  employeeReviewId String             @unique
  hrUserId         String
  status           HRValidationStatus @default(PENDING)
  comments         String?            @db.Text
  flaggedIssues    String?            @db.Text
  validatedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  employeeReview   EmployeeReview     @relation(fields: [employeeReviewId], references: [id], onDelete: Cascade)

  @@map("hr_validations")
}

model Calibration {
  id               String               @id @default(uuid())
  employeeReviewId String               @unique
  calibratedRating Float?
  isCalibrated     Boolean              @default(false)
  reason           String?              @db.Text
  calibratedBy     String?
  calibratedAt     DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  employeeReview   EmployeeReview       @relation(fields: [employeeReviewId], references: [id], onDelete: Cascade)
  history          CalibrationHistory[]

  @@map("calibrations")
}

model CalibrationHistory {
  id            String      @id @default(uuid())
  calibrationId String
  previousRating Float
  newRating     Float
  changedBy     String
  reason        String      @db.Text
  comments      String?     @db.Text
  createdAt     DateTime    @default(now())

  calibration   Calibration @relation(fields: [calibrationId], references: [id], onDelete: Cascade)

  @@map("calibration_histories")
}

model PerformanceDiscussion {
  id               String         @id @default(uuid())
  employeeReviewId String         @unique
  discussionDate   DateTime
  discussedWith    String
  managerNotes     String?        @db.Text
  employeeNotes    String?        @db.Text
  isCompleted      Boolean        @default(false)
  completedAt      DateTime?
  createdAt        DateTime       @default(now())

  employeeReview   EmployeeReview @relation(fields: [employeeReviewId], references: [id], onDelete: Cascade)

  @@map("performance_discussions")
}

model FinalRating {
  id                  String         @id @default(uuid())
  employeeReviewId    String         @unique
  goalScore           Float
  competencyScore     Float
  overallScore        Float
  finalRatingScale    Int            // 1 to 5
  calculationSnapshot String?        @db.Text // JSON string of score calculation details
  finalizedBy         String
  finalizedAt         DateTime       @default(now())

  employeeReview      EmployeeReview @relation(fields: [employeeReviewId], references: [id], onDelete: Cascade)

  @@map("final_ratings")
}

model Acknowledgement {
  id               String         @id @default(uuid())
  employeeReviewId String         @unique
  acknowledgedBy   String
  comments         String?        @db.Text
  ipAddress        String?
  userAgent        String?
  acknowledgedAt   DateTime       @default(now())

  employeeReview   EmployeeReview @relation(fields: [employeeReviewId], references: [id], onDelete: Cascade)

  @@map("acknowledgements")
}

// -------------------------------------------------------------
// 8. DEVELOPMENT PLANS & PROGRESS CHECKS
// -------------------------------------------------------------

enum DevelopmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

model DevelopmentPlan {
  id               String            @id @default(uuid())
  employeeId       String
  reviewCycleId    String
  overallVision    String?           @db.Text
  status           DevelopmentStatus @default(NOT_STARTED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewCycle      ReviewCycle       @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  goals            DevelopmentGoal[]

  @@map("development_plans")
}

model DevelopmentGoal {
  id                String            @id @default(uuid())
  developmentPlanId String
  goalTitle         String
  area              String            // e.g. "Technical Skills", "Leadership"
  currentSkillLevel String?
  targetSkillLevel  String?
  actionSteps       String?           @db.Text
  trainingProgram   String?
  mentorName        String?
  stretchAssignment String?           @db.Text
  successMeasure    String?
  targetDate        DateTime?
  status            DevelopmentStatus @default(NOT_STARTED)
  employeeComment   String?           @db.Text
  managerComment    String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  developmentPlan   DevelopmentPlan   @relation(fields: [developmentPlanId], references: [id], onDelete: Cascade)

  @@map("development_goals")
}

model ProgressCheck {
  id                  String         @id @default(uuid())
  employeeReviewId    String
  checkPeriodMonths   Int            // e.g. 3 or 6 months
  goalProgressNotes   String?        @db.Text
  developmentProgress String?        @db.Text
  achievements        String?        @db.Text
  challenges          String?        @db.Text
  supportRequired     String?        @db.Text
  newGoals            String?        @db.Text
  managerComments     String?        @db.Text
  employeeComments    String?        @db.Text
  conductedAt         DateTime       @default(now())

  employeeReview      EmployeeReview @relation(fields: [employeeReviewId], references: [id], onDelete: Cascade)

  @@map("progress_checks")
}

// -------------------------------------------------------------
// 9. AUDIT, NOTIFICATIONS & FILES
// -------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // e.g. "LOGIN", "REVIEW_SUBMITTED", "RATING_CHANGED"
  entityType String   // e.g. "EmployeeReview", "Goal"
  entityId   String?
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, entityType])
  @@map("audit_logs")
}

model FileAttachment {
  id               String   @id @default(uuid())
  filename         String
  originalFilename String
  mimeType         String
  size             Int
  storagePath      String
  uploadedById     String
  entityType       String   // e.g. "ReviewGoal", "EmployeeReview", "DevelopmentGoal"
  entityId         String
  createdAt        DateTime @default(now())

  uploadedBy       User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("file_attachments")
}

