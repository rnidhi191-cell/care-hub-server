# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Connection (Prisma)
DATABASE_URL="mysql://care_user:care_password@localhost:3306/care_hub"

# MongoDB Connection (Backward compatibility & Atlas)
MONGO_URI="mongodb://username:password@cluster.mongodb.net:27017/carehub?ssl=true&authSource=admin"

# JWT Authentication Secrets
JWT_SECRET="replace_with_a_secure_random_string_for_access_tokens"
REFRESH_SECRET="replace_with_a_secure_random_string_for_refresh_tokens"

# Allowed Client Origin for CORS
CLIENT_URL="http://localhost:5173"
